# Copy to .env on the OFFICE PC (same LAN as the fingerprint device).
# Prefer: Time Card → Hikvision → Agent config → Download office .env
# Then from this folder: npm install && npm start

# Fingerprint device
DEVICE_IP=192.168.1.21
DEVICE_PORT=80
DEVICE_USER=admin
DEVICE_PASSWORD=your-device-web-password

# Copy from HR → Time Card → Hikvision panel → Punches URL
CLOUD_PUNCHES_URL=https://YOUR-HR-API/api/hikvision/punches/YOUR_TOKEN

# Optional: public API base (bridge refreshes host from /api/hikvision/cloud-base)
# CLOUD_BASE_URL=https://YOUR-HR-API

# Optional. Only needed if the HR server .env has HIKVISION_WEBHOOK_SECRET.
# HIKVISION_SECRET=

POLL_SECONDS=60
LOOKBACK_MINUTES=180
