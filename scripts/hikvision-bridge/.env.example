# Copy to .env on the OFFICE PC (same LAN as the fingerprint device).
# Then: npm start   or start-bridge.bat

# Fingerprint device
DEVICE_IP=192.168.1.21
DEVICE_PORT=80
DEVICE_USER=admin
DEVICE_PASSWORD=your-device-web-password

# Copy from HR → Time Card → Hikvision panel → Punches URL
CLOUD_PUNCHES_URL=http://127.0.0.1:8000/api/hikvision/punches/YOUR_TOKEN

# Optional: public API base (bridge refreshes host from /api/hikvision/cloud-base)
# CLOUD_BASE_URL=http://127.0.0.1:8000

# Optional shared secret (must match backend HIKVISION_WEBHOOK_SECRET)
# HIKVISION_SECRET=

POLL_SECONDS=60
LOOKBACK_MINUTES=180
