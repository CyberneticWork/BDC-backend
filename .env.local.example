APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm_backend
DB_USERNAME=root
DB_PASSWORD=

# Hikvision DS-K1T320 integration (optional)
HIKVISION_POLL_INTERVAL=5
HIKVISION_WEBHOOK_SECRET=
HIKVISION_HTTP_HOST_ID=1

# IMPORTANT: This file is for LOCAL development/import only.
# Copy to .env before running:  copy .env.local.example .env
# Then run: php artisan key:generate
