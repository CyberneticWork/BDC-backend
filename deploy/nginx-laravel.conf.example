# =============================================================================
# apihilburn.cyberneticde.site  — Laravel API only (Hilburn HR)
# =============================================================================
# CORS allows https://*.cyberneticde.site (see config/cors.php).
# This vhost must be Laravel public/, not the SPA and not another tenant.
#
# Cloudflare DNS (zone cyberneticde.site)
#   Name:  apihilburn
#   Type:  A
#   IPv4:  THE SERVER WHERE Hilburn-backend IS CLONED
#   Proxy: DNS only (grey cloud) until the vhost below works, then orange.
#
# After nginx -t && reload, this must return JSON:
#   https://apihilburn.cyberneticde.site/index.php/api/public/branding
# =============================================================================

server {
    listen 80;
    listen 443 ssl http2;
    server_name apihilburn.cyberneticde.site;

    root /var/www/hilburn-backend/public;
    index index.php;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php(/|$) {
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
