# =============================================================================
# apihilburn.cyberneticde.site  — Laravel API only
# =============================================================================
# Live problem (2026-09-19): Cloudflare serves CityGreen Agro HTML on this
# hostname. That is a DNS / vhost mistake, not an APP_URL or password bug.
# Do NOT CNAME apihilburn to citygreen, and do NOT point it at apiurbanhr
# (that host returns URBAN EATS company data).
#
# Cloudflare DNS (zone cyberneticde.site)
#   Name:  apihilburn
#   Type:  A
#   IPv4:  THE SERVER WHERE Hilburn-backend IS CLONED  (not CityGreen)
#   Proxy: DNS only (grey cloud) until the vhost below works, then orange.
#   Remove any CNAME/A that targets CityGreen or a default site.
#
# cPanel (if used)
#   Subdomains → apihilburn.cyberneticde.site
#   Document Root:  .../Hilburn-backend/public     ← Laravel public/, NOT public_html of CityGreen
#
# After nginx -t && reload, this must return JSON (not CityGreen HTML):
#   https://apihilburn.cyberneticde.site/index.php/api/public/branding
# =============================================================================

server {
    listen 80;
    listen 443 ssl http2;
    server_name apihilburn.cyberneticde.site;

    root /var/www/hilburn-backend/public;
    index index.php;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php(/|$) {
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
